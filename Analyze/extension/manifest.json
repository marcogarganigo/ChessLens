{
  "manifest_version": 3,
  "name": "ChessLens",
  "short_name": "ChessLens",
  "version": "2.7.17",
  "description": "Review finished Chess.com Live and Daily games with local Stockfish, move badges, an evaluation graph, and accuracy.",
  "minimum_chrome_version": "141",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://api.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ChessLens",
    "default_icon": {
      "16": "assets/toolbar16.png",
      "32": "assets/toolbar32.png",
      "48": "assets/toolbar48.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "archive.js",
        "content.js",
        "move-badges.js",
        "review-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon32.png"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}
